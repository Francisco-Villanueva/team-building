# Public config only. Never put secrets in VITE_ variables.
# Base URL of the API (Render). Leave empty in dev to use the Vite proxy.
VITE_API_URL=
# Realtime WebSocket endpoint (public). Leave empty to force polling.
# Public Realtime host from the Neon console, with the wss:// scheme (e.g. wss://br-xxxx-neonrealtimesocket.compute.<cell>.<region>.aws.neon.tech/)
VITE_NEON_REALTIME_URL=
# Polling interval in ms when Realtime is unavailable
VITE_POLL_MS=1500
